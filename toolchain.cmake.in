SET(CMAKE_SYSTEM_NAME Windows)
SET(CMAKE_SYSTEM_PROCESSOR @TARGET_CPU_FAMILY@)

SET(CMAKE_C_COMPILER @TARGET_ARCH@-gcc)
SET(CMAKE_CXX_COMPILER @TARGET_ARCH@-g++)
SET(CMAKE_RC_COMPILER_INIT @TARGET_ARCH@-windres)
SET(CMAKE_ASM_COMPILER @TARGET_ARCH@-gcc)
SET(CMAKE_CXX_COMPILER_CLANG_SCAN_DEPS clang-scan-deps)

SET(QT_MOC_EXECUTABLE @MINGW_INSTALL_PREFIX@/bin/moc)
SET(QT_RCC_EXECUTABLE @MINGW_INSTALL_PREFIX@/bin/rcc)
SET(QT_UIC_EXECUTABLE @MINGW_INSTALL_PREFIX@/bin/uic)

LIST(APPEND CMAKE_PROGRAM_PATH @CMAKE_INSTALL_PREFIX@/bin ...)
SET(CMAKE_FIND_ROOT_PATH @MINGW_INSTALL_PREFIX@)
SET(CMAKE_INSTALL_PREFIX @MINGW_INSTALL_PREFIX@)
SET(CMAKE_SYSROOT @MINGW_INSTALL_PREFIX@)

SET(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
SET(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
SET(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)

# ---------------------------------------------------------------------------
# 基础编译参数
#
# 注意 1：toolchain 文件里的普通 set() 会遮蔽同名 cache 变量，如果这里直接写
#         set(CMAKE_C_FLAGS "-O3 ...")，那么各包通过
#         -DCMAKE_C_FLAGS='...' 传入的参数（如 mbedtls 的 -maes、
#         vulkan 的 -Dparse_number=...、libjxl 的 -DJXL_STATIC_DEFINE、
#         mediaxx 的 -fvisibility=hidden）会被静默丢弃。
#         所以这里改成 “基础参数在前 + 调用方参数在后”，两者都保留，后者优先级更高。
#
# 注意 2：toolchain 文件在一次 configure 中会被读取多次，所以必须做幂等保护，
#         否则基础参数会在命令行上重复拼接。
# ---------------------------------------------------------------------------
if(NOT DEFINED MEDIAXX_BASE_CFLAGS_APPLIED)
    set(MEDIAXX_BASE_CFLAGS_APPLIED TRUE)
    set(_MEDIAXX_BASE_FLAGS "-fPIC -ffunction-sections -fdata-sections -O3 -flto")
    set(CMAKE_C_FLAGS   "${_MEDIAXX_BASE_FLAGS} ${CMAKE_C_FLAGS}")
    set(CMAKE_CXX_FLAGS "${_MEDIAXX_BASE_FLAGS} ${CMAKE_CXX_FLAGS}")
endif()